ace-between;\n}\n.total {\n  color: rgb(100, 100, 100);\n  margin-top: 20px;\n  border-top: 1px dotted var(--text-gary);\n}\n.bill .details .item p {\n  color: rgb(87, 86, 86) !important;\n  font-size: 17px;\n}\n.checkoutarea {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n}\n.checkoutarea button {\n  width: 300px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 0px !important;\n  margin-left: 40px;\n  margin-top: 10px;\n  box-shadow: 0px 0px 4px var(--primary);\n}\n.free {\n  color: #388e3c !important;\n  text-transform: uppercase;\n  font-weight: 600;\n}\n\n.allitems.cart-card{\n  height: 400px;\n  \n}\n\n\n\n.cartarea {\n  padding: 20px;\n  display: flex;\n  align-items: flex-start;\n  justify-content: flex-start;\n  /* flex-direction: column; */\n}\n.cartarea .cart-card {\n  padding: 20px 20px;\n  border-radius: 20px;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  height: 160px;\n  margin: 20px 0;\n  background: #fff;\n  box-shadow: 0 4px 12px 0 rgb(0 0 0 / 5%);\n  width:100%;\n}\n.cartarea .cart-card .img {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  background: rgba(17, 43, 61, 1);\n  border-radius: 20px;\n  padding: 10px;\n  margin-right: 20px;\n}\n\n\n.allitems h2 {\n  font-size: 15px;\n}\n.allitems h3 {\n  font-size: 15px;\n}\n.allitems .img img {\n  height: 50px;\n  width: 50px;\n  \n  \n}\n.allitems .cart-card {\n  height: 120px;\n  padding: 10px;\n  width: 350px;\n  \n  \n  box-shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.151);\n}\n\n\n@media (max-width: 1104px) {\n  .cart-screen {\n    display: block;\n    width: 60%;\n    margin-left: -20px; \n  }\n  .cartarea {\n    padding: 20px;\n    display: block;\n    /* align-items: flex-start; */\n    /* justify-content: flex-start; */\n    /* flex-direction: column; */\n  }\n  .bill{\n    width:180%;\n    margin-left: 150px;\n  }\n  .checkoutarea button {\n    width : 300px;\n    margin-left: 150px;\n  }\n\n\n  \n  \n}"],"sourceRoot":""}]);
